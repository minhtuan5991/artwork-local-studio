{
  "manifest_version": 3,
  "name": "Artwork Local Studio — Nhận ảnh web",
  "version": "0.2.3",
  "description": "Nhận ảnh website, chọn rectangle/lasso và chuyển vào app Qwen local.",
  "key": "",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_title": "Artwork Local Studio · chọn ảnh trong trang", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}
}
